{
  "name": "inline-html",
  "version": "1.0.1",
  "description": "Export Markdown notes as standalone HTML documents with customizable inline CSS styles and presets for publishing platforms.",
  "main": "main.js",
  "author": "qijixiaoshu",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
